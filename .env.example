# --- Supabase (obligatoire) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# --- Claude (obligatoire : analyse, résumés, quiz, discussion) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Modèle utilisé pour toutes les tâches (défaut : claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5

# --- ElevenLabs (lecture audio MP3 et voix personnalisée) ---
# Sans cette clé, la lecture reste disponible dans le navigateur (sans export MP3).
NEXT_ILEVENLABS_KEY=
# Voix par défaut : identifiant d’une voix de votre bibliothèque ElevenLabs.
# Vide = « Bakumba » (cEjGxRhK5rId1bacJPJr, français). Autres voix françaises du compte :
#   Audrey : McVZB9hVxVSk3Equu8EH · Malick, homme, Sénégal : 4NXnXTAwm3xM0tMCOn0r · Luca : usy5mXLbV9SeGWACyT3Y
ELEVENLABS_DEFAULT_VOICE_ID=cEjGxRhK5rId1bacJPJr
# Modèle ElevenLabs (défaut : eleven_v4, expressif ; alternative : eleven_multilingual_v2)
ELEVENLABS_MODEL=eleven_v4
# Limite de caractères envoyés à ElevenLabs par lecture (défaut : 20000)
TTS_MAX_CHARS=20000
# Nombre maximal de voix personnalisées par étudiant (défaut : 3 ; le compte ElevenLabs est partagé)
MAX_VOICES_PER_USER=5

# Voix de l’« invité » dans les podcasts à deux voix (défaut : Audrey, McVZB9hVxVSk3Equu8EH)
ELEVENLABS_PODCAST_VOICE_ID=

# --- Clé secrète Supabase (côté serveur uniquement) ---
# Project Settings → API Keys → clé « secret » (sb_secret_…) ou service_role.
# Avec RESEND_API_KEY ou SMTP_*, l’application génère et envoie elle-même les e-mails d’authentification
# (confirmation d’inscription, mot de passe oublié) sans le serveur d’e-mail de Supabase.
# Sert aussi à la suppression de comptes depuis l’espace administrateur (/admin).
SUPABASE_SECRET_KEY=

# --- E-mails (authentification et notifications de partage) ---
# Option A, sans domaine : SMTP d’un compte Gmail avec un « mot de passe d’application »
# (Google → Sécurité → Validation en deux étapes → Mots de passe des applications). ~500 e-mails/jour.
# Fonctionne aussi avec Brevo (smtp-relay.brevo.com:587, expéditeur vérifié), OVH, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=vous@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Option B, avec un domaine vérifié chez Resend (prioritaire : SMTP si renseigné, sinon Resend).
RESEND_API_KEY=re_xxxxxxxx
# Expéditeur affiché. Avec Gmail, l’adresse doit être celle du compte SMTP.
EMAIL_FROM=Janngude <vous@gmail.com>

# --- Supabase : jeton d’accès personnel (installation des modèles d’e-mail via `npm run email:push`) ---
# À créer sur https://supabase.com/dashboard/account/tokens ; jamais exposé côté client.
SUPABASE_ACCESS_TOKEN=

# --- Application ---
# URL publique du site (liens de partage, invitations, e-mails). Sur Vercel, laissez vide : le domaine de production
# est utilisé automatiquement ; renseignez-la seulement avec un domaine personnalisé (https://janngude.sn).
NEXT_PUBLIC_APP_URL=http://localhost:3000
